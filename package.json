{
  "name": "recall-english",
  "private": true,
  "version": "0.1.0",
  "description": "Recall English — local-first active-recall English study for Malaysian campus, business, and finance/accounting.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint src scripts e2e vite.config.ts playwright.config.ts --config .oxlintrc.json",
    "preview": "vite preview",
    "share:export": "node scripts/exportShareBundle.mjs",
    "share:check": "node scripts/checkShareBundle.mjs",
    "vocabulary:export": "node scripts/exportVocabularyArchive.mjs",
    "seed:pack": "node scripts/buildBundledSeedPack.mjs",
    "seed:senses": "node scripts/buildDictionarySensePack.mjs",
    "seed:contexts": "node scripts/enrichDictionaryContexts.mjs",
    "seed:validate-sense": "node scripts/validateSenseConsistency.mjs --strict",
    "seed:slice": "node scripts/sliceTrustedVocabularyPack.mjs",
    "seed:enrich-v1": "node scripts/enrichTrustedV1.mjs",
    "seed:quality": "node scripts/qualityHarnessVocabulary.mjs",
    "seed:v5": "npm run seed:slice && npm run seed:enrich-v1 && npm run seed:pack && npm run seed:quality"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-fsrs": "^5.4.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
