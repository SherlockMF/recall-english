# Local Vite development reads .env.local. Keep the two VITE_SUPABASE_* values
# empty for the existing local-only app; set both to enable invited cloud login.
# Public build configuration, also required by the production Node server.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Production process environment / Render Environment settings.
# npm start does not load .env.local automatically. Never put secrets in VITE_*.
APP_ORIGIN=https://lomivex.top
SUPABASE_SECRET_KEY=
DEEPSEEK_API_KEY=
# Beijing-region Alibaba Cloud Model Studio credentials; server only.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# Optional seed-import URL; defaults to VITE_SUPABASE_URL.
SUPABASE_URL=
# PORT is provided by Render; omit it there.
# Never commit real values or include .env.local in a share bundle.
